# Service Socket.IO des Watch Parties.
#
# Aucune dependance native : Alpine suffit et divise la taille par trois.
FROM node:22-alpine AS deps
WORKDIR /app
COPY API/watchpartyAPI/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# ---------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache curl
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY API/watchpartyAPI/ ./

RUN mkdir -p data && chown -R node:node /app
USER node
EXPOSE 25566

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${WATCHPARTY_PORT:-25566}/health" || exit 1

CMD ["node", "watchparty.js"]
